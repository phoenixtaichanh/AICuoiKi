@startuml UseCaseDiagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #E1F5FE
    BorderColor #01579B
}
skinparam actor {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}

title Use Case Diagram - AI Travel Assistant System

actor "User" as User
actor "Administrator" as Admin

package "AI Travel Assistant System" {
    usecase "Login" as UC_LOGIN
    usecase "Register" as UC_REGISTER
    usecase "Logout" as UC_LOGOUT
    usecase "Plan Travel Itinerary" as UC1
    usecase "Q&A about Places" as UC2
    usecase "Recognize Place from Image" as UC3
    usecase "Smart Search" as UC4
    usecase "Google Search" as UC5
    usecase "Process Query with LLM" as UC6
    usecase "View Recommendation Explanations" as UC7
    usecase "Validate Itinerary" as UC8
    usecase "Upload Image" as UC9
    usecase "Crawl Place Data" as UC10
    usecase "Clean Data" as UC11
    usecase "Save Chat History" as UC12
}

User --> UC_LOGIN : "Enter username\nand password"
User --> UC_REGISTER : "Create new\naccount"
User --> UC_LOGOUT : "Logout"
User --> UC1 : "Enter natural\nlanguage query"
User --> UC2 : "Ask questions\nabout places"
User --> UC3 : "Upload place\nimage"
User --> UC4 : "Smart query\n(auto routing)"
User --> UC9 : "Select image file"
User --> UC7 : "View recommendation\nreasons"
User --> UC12 : "Save chat history"

Admin --> UC10 : "Update\ndata"
Admin --> UC11 : "Normalize\ndata"

UC_LOGIN ..> UC12 : "include"
UC1 ..> UC_LOGIN : "extend\n(requires login)"
UC2 ..> UC_LOGIN : "extend\n(requires login)"
UC3 ..> UC_LOGIN : "extend\n(requires login)"

UC1 ..> UC8 : "include"
UC1 ..> UC7 : "include"
UC4 ..> UC1 : "extend"
UC4 ..> UC2 : "extend"
UC4 ..> UC5 : "extend"
UC4 ..> UC6 : "extend"
UC3 ..> UC2 : "extend"
UC9 ..> UC3 : "include"

note right of UC_LOGIN
  Simple login system:
  - Check localStorage
  - Validate username/password
  - Save currentUser
  - Load chat history
end note

note right of UC_REGISTER
  Register new account:
  - Validate input
  - Check username exists
  - Hash password
  - Add to database
end note

note right of UC1
  Auto extract:
  - Budget (default: 3M VND)
  - Days (default: 1)
  - Travel companion (default: solo)
  - City
end note

note right of UC3
  Supports:
  - Gemini (free)
  - OpenAI Vision
  - Hugging Face
end note

@enduml

@startuml ActivityDiagram_Itinerary
!theme plain
skinparam backgroundColor #FFFFFF
skinparam activity {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
}
skinparam decision {
    BackgroundColor #FFF3E0
    BorderColor #E65100
}

title Activity Diagram - Travel Itinerary Planning

start

:User enters query;

:Query Extractor extracts information;
note right
  - Budget (default: 3M VND)
  - Days (default: 1)
  - City (default: Da Nang)
  - Travel companion (default: solo)
end note

if (LLM available?) then (yes)
  :LLM Processor processes query;
  :Enhance query;
else (no)
endif

:Recommender.encode_query();
:Calculate cosine similarity;
:Filter by city;

if (Cross-Encoder available?) then (yes)
  :Rerank with Cross-Encoder;
else (no)
endif

:Apply diversity filter;
:Classify by category\n(sightseeing, food, hotel, event);

:Optimize slot selection;
note right
  - Morning (09:00)
  - Lunch (12:00)
  - Afternoon (15:00)
  - Evening (19:00)
  - Hotel
end note

:Calculate distances\n(Haversine);
:Check opening hours;
:Check budget constraints;

if (Validate plan?) then (yes)
  :Plan Guard validates;
  if (Valid?) then (yes)
  else (no)
    :Add warnings;
  endif
endif

if (Include explanation?) then (yes)
  :Explain Ability\ngenerates explanations;
else (no)
endif

:Return itinerary;

stop

@enduml

